; Top Design: "LNA_lib:LNA24_PRELIM:schematic"
; Netlisted using Hierarchy Policy: "Standard"

Options ResourceUsage=yes UseNutmegFormat=no EnableOptim=no TopDesignName="LNA_lib:LNA24_PRELIM:schematic" DcopOutputNodeVoltages=yes DcopOutputPinCurrents=yes DcopOutputAllSweepPoints=no DcopOutputDcopType=0
; Library Name: tubspdk_lib
; Cell Name: nmos
; View Name: schematic
define nmos ( b  d  g  s ) 
parameters  W=1 um  L=0.12 um  Nf=1 
"nmos_modelcard":MOSFET1  d N__4 s b Length=L Width=W Nf=Nf Sa=0.32 um Sb=0.32 um Sd=0.36 um Geomod=0 Rgeomod=1 Mode=1 Noise=yes 
R:R1  g N__4 R=W/L*Rgate_sht/Nf/Nf/3 Noise=yes 

Rgate_sht=10
end nmos

nmos:Q1  src_p vout_n vin_p_int src_p W=4 um L=0.12 um Nf=1 _M=1 
nmos:Q2  src_n vout_p vin_n_int src_n W=4 um L=0.12 um Nf=1 _M=1 
Termination:P_IN vin_p vin_n  Load=100 Ohm
Termination:P_OUT vout_p vout_n  Load=100 Ohm
V_Source:VDD  0 VDD Type="V_DC" Vdc=1.5 V SaveCurrent=1 
V_Source:VBIAS  0 VBIAS Type="V_DC" Vdc=0.8 V SaveCurrent=1 
R:RB1  VBIAS vin_p_int R=1 MOhm Noise=yes 
R:RB2  VBIAS vin_n_int R=1 MOhm Noise=yes 
L:TEMP_LG1  vin_p vin_p_int L=8.75 nH R=0 Noise=yes  
L:TEMP_LG2  vin_n vin_n_int L=8.75 nH R=0 Noise=yes  
L:TEMP_LS1  src_p 0 L=0.10 nH R=0 Noise=yes  
L:TEMP_LS2  src_n 0 L=0.10 nH R=0 Noise=yes  
L:TEMP_LD1  VDD vout_n L=3.06 nH R=0 Noise=yes  
L:TEMP_LD2  VDD vout_p L=3.06 nH R=0 Noise=yes  
C:COUT1  vout_n 0 C=14.3 fF 
C:COUT2  vout_p 0 C=14.3 fF 
S_Param:SP1 CalcS=yes CalcY=no CalcZ=no GroupDelayAperture=1e-4 FreqConversion=no FreqConversionPort=1 StatusLevel=2 CalcNoise=yes SortNoise=0 BandwidthForNoise=1.0 Hz DevOpPtLevel=0 NoiseInputPort=1 NoiseOutputPort=2 SPSS_WSP=yes \
SweepVar="freq" SweepPlan="SP1_stim" OutputPlan="SP1_Output" 

SweepPlan: SP1_stim Start=10 GHz Stop=40 GHz Step=100 MHz 

OutputPlan:SP1_Output \
      Type="Output" \
      UseEquationNestLevel=yes \
      EquationNestLevel=2 \
      UseSavedEquationNestLevel=yes \
      SavedEquationNestLevel=2

#load "python","LinearCollapse"
Component Module="LinearCollapse" Type="ModelExtractor" NetworkRepresentation=2
